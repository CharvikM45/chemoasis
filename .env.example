# Copy to .env for local development (never commit .env).
# Use your Railway Postgres "DATABASE_PUBLIC_URL" here: the private one only works inside Railway.
DATABASE_URL=postgresql://postgres:password@host.proxy.rlwy.net:12345/railway
# Set to true if the connection needs SSL.
PGSSL=
NODE_ENV=development
PORT=3000
# Comma-separated emails of community moderators (they see the forum review queue).
MODERATOR_EMAILS=
# Encrypts questionnaire answers and play history before they're stored. Required in production.
# Make one with: openssl rand -base64 32
DATA_KEY=
# Extra websites allowed to send sign-in and forum requests (comma-separated), for example a
# Vercel preview. Leave empty when the site and the server share one address.
ALLOWED_ORIGINS=
# Turns on the Research Studio's design assistant and the advisory review of submissions (Claude).
# Leave empty to keep both off; everything else in the Studio still works. Paid: needs an adult's account.
ANTHROPIC_API_KEY=
